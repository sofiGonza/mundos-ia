# Copia este archivo como .env y pega tus claves reales.
# El archivo .env NO se sube a Git (está en .gitignore).
# Nunca subas ni compartas un .env con claves reales.

# --- Servicio de texto: Groq (https://console.groq.com) ---
TEXTO_API_KEY=pega_aqui_tu_clave_de_groq
TEXTO_URL=https://api.groq.com/openai/v1/chat/completions
TEXTO_MODELO=openai/gpt-oss-20b

# --- Servicio de imagen: NVIDIA FLUX.1-schnell (https://build.nvidia.com) ---
IMAGEN_API_KEY=pega_aqui_tu_clave_de_nvidia
IMAGEN_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-schnell